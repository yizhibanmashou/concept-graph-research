{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wordnet-gloss-horn:claim-review-candidate-manifest:0.2",
  "title": "Frozen gloss-hypothesis candidate manifest",
  "description": "Text-free, gold-free manifest for binding reviewed claim pairs to a separately pinned candidate-set file hash.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "candidate_set_version", "candidate_count", "candidates"],
  "properties": {
    "schema_version": {"const": "claim-review-candidate-manifest/0.2"},
    "candidate_set_version": {"type": "string", "minLength": 1},
    "candidate_count": {"type": "integer", "minimum": 1},
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate_id", "group_id", "split", "source", "direction",
          "premise_sha256", "hypothesis_sha256"
        ],
        "properties": {
          "candidate_id": {"type": "string", "minLength": 1},
          "group_id": {"type": "string", "minLength": 1},
          "split": {"enum": ["train", "dev", "test", "unassigned"]},
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": ["resource", "release", "sense_id", "pos"],
            "properties": {
              "resource": {"type": "string", "minLength": 1},
              "release": {"type": "string", "minLength": 1},
              "sense_id": {"type": "string", "minLength": 1},
              "pos": {"enum": ["n", "v", "a", "r"]}
            }
          },
          "direction": {"enum": ["target_to_gloss", "gloss_to_target", "both", "none"]},
          "premise_sha256": {"$ref": "#/$defs/sha256"},
          "hypothesis_sha256": {"$ref": "#/$defs/sha256"},
          "relation": {"enum": ["necessary", "sufficient", "biconditional", "typical", "example", "other"]},
          "formula_sha256": {"$ref": "#/$defs/sha256"},
          "composition": {"$ref": "#/$defs/composition"}
        },
        "allOf": [
          {
            "if": {"required": ["composition"]},
            "then": {"required": ["formula_sha256"]}
          }
        ]
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operator", "components"],
      "properties": {
        "operator": {"enum": ["and", "or"]},
        "components": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["candidate_id", "negated"],
            "properties": {
              "candidate_id": {"type": "string", "minLength": 1},
              "negated": {"type": "boolean"}
            }
          }
        }
      }
    }
  }
}
